# LLM provider: "gemini" (default) or "mock" (no API key needed)
LLM_PROVIDER=gemini

# Your Google Gemini API key — leave blank to use LLM_PROVIDER=mock
GEMINI_API_KEY=

# Gemini model to use (default: gemini-2.5-flash, current stable Flash)
GEMINI_MODEL=gemini-2.5-flash

# Request timeout in seconds for Gemini API calls
LLM_TIMEOUT_SECONDS=20
